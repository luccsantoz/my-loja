
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tech tudos</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f5f5f5;color:#171717;
font-family:Arial,sans-serif}
header{background:#171717;color:white;padding:22px 16px}
header h1{margin:0 0 8px}
header p{margin:0;color:#ddd}
main{max-width:950px;margin:auto;padding:18px}
input{width:100%;padding:13px;border:1px solid #ddd;
border-radius:10px;font-size:16px;margin-bottom:18px}
h2{margin-top:8px}
.produtos{display:grid;grid-template-columns:
repeat(2,minmax(0,1fr));gap:12px}
.produto{background:white;border-radius:12px;
padding:10px;box-shadow:0 2px 8px #0000000b}
.produto img{width:100%;aspect-ratio:1;
object-fit:cover;border-radius:8px}
.produto h3{font-size:16px;margin:10px 0 5px}
.preco{font-size:19px;font-weight:bold}
button{border:0;border-radius:8px;padding:12px;
background:#171717;color:white;font-weight:bold;
width:100%;margin-top:9px;font-size:14px}
.carrinho{background:white;padding:16px;
border-radius:12px;margin-top:22px}
footer{text-align:center;padding:25px;color:#666}
@media(min-width:650px){
.produtos{grid-template-columns:repeat(3,minmax(0,1fr))}
}
</style>
</head>
<body>
<header>
  <h1>MINHA LOJA</h1>
  <p>Encontre seus produtos favoritos!</p>
</header>
<main>
  <input id="busca" placeholder="Buscar produtos..."
  oninput="mostrar()">
  <h2>Nossos produtos</h2>
  <section class="produtos" id="produtos"></section>
  <section class="carrinho">
    <h2>Meu carrinho</h2>
    <div id="itens">Seu carrinho está vazio.</div>
    <p id="total">Total: R$ 0,00</p>
    <button onclick="pedir()">Finalizar pedido no WhatsApp</button>
  </section>
</main>
<footer>Obrigado por visitar nossa loja ❤️</footer>
<script>
const WHATSAPP = "5521977137748";
const produtos = [
 {nome:"Controle Xbox one Original",preco:349.90,
 foto:"https://share.google/Ssiyzn9tuTGlPv3k0"},
 {nome:"Controle Ps4 Dualshock Originial",preco:209.90,
 foto:"https://share.google/ooyiIml1jgBTfOiYr"},
 {nome:"Gift Card 50$ (Qualquer plataforma)",preco:49.90,
 foto:"https://share.google/aQtrYgzktssl4NNH7"}
];
let carrinho=[];
const dinheiro=n=>n.toLocaleString("pt-BR",
{style:"currency",currency:"BRL"});
function mostrar(){
 const termo=document.getElementById("busca").value.toLowerCase();
 document.getElementById("produtos").innerHTML=
 produtos.map((p,i)=>({p,i})).filter(x=>
 x.p.nome.toLowerCase().includes(termo)).map(({p,i})=>
 `<article class="produto">
 <img src="${p.foto}" alt="${p.nome}">
 <h3>${p.nome}</h3><div class="preco">${dinheiro(p.preco)}</div>
 <button onclick="adicionar(${i})">Adicionar ao carrinho</button>
 </article>`).join("");
}
function adicionar(i){
 carrinho.push(produtos[i]);atualizar();
}
function atualizar(){
 document.getElementById("itens").innerHTML=carrinho.length?
 carrinho.map((p,i)=>`${p.nome} — ${dinheiro(p.preco)}
 <button onclick="remover(${i})">Remover</button>`).join("<hr>"):
 "Seu carrinho está vazio.";
 document.getElementById("total").textContent=
 "Total: "+dinheiro(carrinho.reduce((s,p)=>s+p.preco,0));
}
function remover(i){carrinho.splice(i,1);atualizar()}
function pedir(){
 if(!carrinho.length){alert("Adicione um produto primeiro!");return}
 if(!/^55\d{10,11}$/.test(WHATSAPP)){
 alert("Configure o número do WhatsApp no código.");return}
 const resumo=carrinho.map(p=>p.nome+" - "+dinheiro(p.preco)).join("\n");
 const total=carrinho.reduce((s,p)=>s+p.preco,0);
 const msg="Olá! Quero fazer este pedido:\n"+resumo+
 "\nTotal: "+dinheiro(total);
 window.open("https://wa.me/"+WHATSAPP+
 "?text="+encodeURIComponent(msg),"_blank");
}
mostrar();
</script>
</body>
</html>
